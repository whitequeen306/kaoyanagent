{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api.schema.json",
  "title": "Kaoyan Assistant API Contract v1",
  "description": "All browser calls are same-origin and route through /functions/v1/app. Anonymous records are partitioned by device_id; every write requires Idempotency-Key and a server-issued device session.",
  "errorCodes": {
    "invalid_input": 400,
    "unauthorized_device": 401,
    "forbidden": 403,
    "not_found": 404,
    "state_conflict": 409,
    "idempotency_conflict": 409,
    "payload_too_large": 413,
    "ai_invalid_json": 502,
    "quota_exceeded": 429,
    "model_unavailable": 503,
    "storage_unavailable": 503,
    "internal_error": 500
  },
  "routes": [
    {
      "name": "resolve_concepts",
      "method": "POST",
      "path": "/api/concepts/resolve",
      "requestRequired": ["text"],
      "requestProperties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "responseItem": {
        "term": "string",
        "node_id": "uuid",
        "level": "integer",
        "expand_to": "subtree|leaf",
        "leaf_ids": "uuid[]",
        "candidate_count": "integer"
      }
    },
    {
      "name": "get_ai_settings",
      "method": "GET",
      "path": "/api/ai-settings",
      "responseProperties": ["configured", "base_url", "model", "has_key", "key_hint"]
    },
    {
      "name": "save_ai_settings",
      "method": "POST",
      "path": "/api/ai-settings",
      "requestRequired": ["base_url", "model"],
      "requestProperties": {
        "base_url": {"type": "string", "maxLength": 500},
        "api_key": {"type": "string", "maxLength": 500},
        "model": {"type": "string", "maxLength": 200}
      },
      "responseProperties": ["settings", "latency_ms"]
    },
    {
      "name": "get_daily_question",
      "method": "GET",
      "path": "/api/daily-question",
      "responseProperties": ["date", "status", "reason", "question", "result", "ai_messages"],
      "result": {
        "nullable": true,
        "correct": "boolean|null (null when awaiting a legible answer)",
        "retryable": "boolean",
        "answer_kind": "text|image",
        "answer_raw": "string|null",
        "in_wrong_book": "boolean",
        "feedback": "string",
        "grading_status": "string",
        "review": "null before final judgment; otherwise {correct_answer, explanation, solution_steps}"
      }
    },
    {
      "name": "submit_daily_question",
      "method": "POST",
      "path": "/api/daily-question/submit",
      "description": "Submit a nonblank answer_raw or an answer_image. Choices and literal fill-in matches are checked directly. Other mathematical text and images use the device's configured model. Returns the daily question view. A final wrong answer enters the device's review schedule once.",
      "requestRequired": ["date", "question_id"],
      "requestProperties": {
        "date": {"type": "string", "format": "date", "description": "Shanghai date shown on the daily question; stale pages receive 409."},
        "question_id": {"type": "string", "format": "uuid"},
        "answer_raw": {"type": "string", "maxLength": 20000},
        "answer_image": {
          "type": "object",
          "required": ["mime_type", "data_url"],
          "properties": {
            "mime_type": {"type": "string", "enum": ["image/png", "image/jpeg", "image/webp"]},
            "data_url": {"type": "string", "maxLength": 6000000}
          }
        },
        "confirmed_latex": {"type": ["string", "null"]},
        "duration_sec": {"type": ["integer", "null"], "minimum": 0}
      },
      "responseProperties": ["date", "status", "reason", "question", "result", "ai_messages"]
    },
    {
      "name": "explain_daily_question",
      "method": "POST",
      "path": "/api/daily-question/explain",
      "requestRequired": ["date"],
      "requestProperties": {"date": {"type": "string", "format": "date"}, "prompt": {"type": "string", "maxLength": 1000}},
      "responseProperties": ["date", "status", "reason", "question", "result", "ai_messages"]
    },
    {
      "name": "get_agent_state",
      "method": "GET",
      "path": "/api/agent/state",
      "responseProperties": ["user_profile", "agent_summary", "preferences", "plans", "conversations", "tasks"]
    },
    {
      "name": "save_agent_profile",
      "method": "POST",
      "path": "/api/agent/profile",
      "responseProperties": ["user_profile"]
    },
    {
      "name": "save_agent_preferences",
      "method": "POST",
      "path": "/api/agent/preferences",
      "responseProperties": ["preferences"]
    },
    {
      "name": "save_agent_summary",
      "method": "POST",
      "path": "/api/agent/summary",
      "responseProperties": ["agent_summary"]
    },
    {
      "name": "create_agent_task",
      "method": "POST",
      "path": "/api/agent/tasks",
      "requestRequired": ["goal"],
      "responseProperties": ["id", "conversation_id", "status", "stage", "steps", "result"]
    },
    {
      "name": "advance_agent_task",
      "method": "POST",
      "path": "/api/agent/tasks/{task_id}/step",
      "responseProperties": ["id", "status", "stage", "steps", "result", "context_state"]
    },
    {
      "name": "confirm_agent_task",
      "method": "POST",
      "path": "/api/agent/tasks/{task_id}/confirm",
      "requestRequired": ["approve"],
      "responseProperties": ["id", "status", "stage", "result"]
    },
    {
      "name": "get_agent_conversation",
      "method": "GET",
      "path": "/api/agent/conversations/{conversation_id}",
      "responseProperties": ["id", "messages", "summary", "updated_at"]
    },
    {
      "name": "update_study_plan",
      "method": "PATCH",
      "path": "/api/agent/plans/{plan_id}",
      "responseProperties": ["plan"]
    },
    {
      "name": "compose_paper",
      "method": "POST",
      "path": "/api/papers/compose",
      "requestRequired": ["concept_node_ids", "qtypes", "count", "source_mode", "mode", "difficulty"],
      "requestProperties": {
        "concept_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}},
        "qtypes": {"type": "array", "minItems": 1, "items": {"enum": ["single_choice", "fill_blank", "free_response"]}},
        "count": {"type": "integer", "minimum": 1, "maximum": 30},
        "source_mode": {"enum": ["real", "ai", "mixed"]},
        "mode": {"enum": ["exam", "drill"]},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "year_from": {"type": ["integer", "null"], "minimum": 2005, "maximum": 2026},
        "year_to": {"type": ["integer", "null"], "minimum": 2005, "maximum": 2026},
        "exclude_done": {"type": "boolean"}
      },
      "responseProperties": ["paper_instance_id", "job_id", "status", "stage", "progress", "detail", "expected_count", "generated_count", "verified_count", "reused_count", "items", "total_score_x2", "actual_ratio", "adjustments"]
    },
    {
      "name": "list_my_papers",
      "method": "GET",
      "path": "/api/papers",
      "responseProperties": ["items"]
    },
    {
      "name": "get_paper",
      "method": "GET",
      "path": "/api/papers/{paper_instance_id}",
      "responseProperties": ["id", "mode", "source_mode", "items_json", "total_score_x2", "status", "adjustments", "result"]
    },
    {
      "name": "submit_answers",
      "method": "POST",
      "path": "/api/papers/{paper_instance_id}/submit",
      "requestRequired": ["answers"],
      "requestProperties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question_id", "answer_raw"],
            "properties": {
              "question_id": {"type": "string", "format": "uuid"},
              "answer_raw": {"type": "string", "maxLength": 20000},
              "confirmed_latex": {"type": ["string", "null"]},
              "duration_sec": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      },
      "responseProperties": ["paper_instance_id", "score_x2", "max_score_x2", "score_rate_bp", "attempts", "diagnosis"]
    },
    {
      "name": "recognize_answer",
      "method": "POST",
      "path": "/api/recognition",
      "requestRequired": ["image_asset_id", "question_id"],
      "responseProperties": ["recognized_latex", "confidence", "needs_confirmation"]
    },
    {
      "name": "generate_variant",
      "method": "POST",
      "path": "/api/variants",
      "requestRequired": ["items"],
      "requestProperties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["question_id", "count"],
            "properties": {
              "question_id": {"type": "string", "format": "uuid"},
              "count": {"type": "integer", "minimum": 3, "maximum": 10}
            }
          }
        }
      },
      "responseProperties": ["job_id", "status", "stage", "progress", "detail", "expected_count", "reused_count"]
    },
    {
      "name": "list_wrong_book",
      "method": "GET",
      "path": "/api/wrong-book",
      "responseProperties": ["items"],
      "daily_answer": "null for a paper attempt; for a daily answer: {date, correct, answer_kind, answer_raw, feedback}"
    },
    {
      "name": "delete_wrong_book_entry",
      "method": "DELETE",
      "path": "/api/wrong-book/{question_id}",
      "responseProperties": ["deleted", "question_id"]
    },
    {
      "name": "get_generation_job",
      "method": "GET",
      "path": "/api/jobs/{job_id}",
      "responseProperties": ["id", "kind", "status", "progress", "result_json", "error"]
    },
    {
      "name": "report_question",
      "method": "POST",
      "path": "/api/questions/{question_id}/reports",
      "requestRequired": ["reason"],
      "requestProperties": {
        "reason": {"enum": ["wrong_answer", "unsolvable", "ambiguous", "out_of_syllabus", "duplicate"]},
        "detail": {"type": ["string", "null"], "maxLength": 1000}
      },
      "responseProperties": ["report_id", "question_status"]
    },
    {
      "name": "review_schedule",
      "method": "GET",
      "path": "/api/review/today",
      "responseProperties": ["items", "count"]
    },
    {
      "name": "metrics_current",
      "method": "GET",
      "path": "/api/metrics/current",
      "responseProperties": ["metrics", "sample_sizes", "generated_at"]
    },
    {
      "name": "metrics_trends",
      "method": "GET",
      "path": "/api/metrics/trends",
      "responseProperties": ["series", "from", "to", "insufficient_data"]
    },
    {
      "name": "metrics_public_paper",
      "method": "GET",
      "path": "/api/metrics/papers/{paper_instance_id}",
      "responseProperties": ["id", "mode", "source_mode", "created_at", "total_score_x2", "actual_ratio", "concepts", "items", "note"]
    }
  ]
}
